{
  "name": "chrome-capture",
  "version": "0.1.0",
  "description": "Zero-dependency 60-120fps / 4K tab video + audio capture from Chromium (M153+) via CDP Page.startScreenRecording",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./pptr": {
      "types": "./dist/pptr.d.ts",
      "default": "./dist/pptr.js"
    }
  },
  "bin": {
    "chrome-capture": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "start": "node src/cli.ts",
    "test": "pnpm run typecheck && pnpm run test:node",
    "test:node": "node --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "preflight": "pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "keywords": [
    "cdp",
    "chrome",
    "chromium",
    "screen-recording",
    "video-capture",
    "playwright",
    "puppeteer",
    "60fps",
    "120fps",
    "av1"
  ],
  "author": "Paul Irish",
  "license": "Apache-2.0",
  "homepage": "https://paulirish.github.io/chrome-capture/",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulirish/chrome-capture.git"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "devtools-protocol": "0.0.1734725",
    "oxlint": "1.92.0",
    "playwright-core": "1.65.0",
    "puppeteer-core": "25.16.0",
    "tsdown": "^0.23.7",
    "typescript": "7.0.2"
  }
}
