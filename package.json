{
  "name": "chrome-capture-60fps",
  "version": "0.1.0",
  "description": "Zero-dependency 60-120fps / 4K tab video + audio capture from Chromium (M153+) via CDP Page.startScreenRecording",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./playwright": "./src/playwright.ts",
    "./pptr": "./src/pptr.ts"
  },
  "bin": {
    "chrome-capture-60fps": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "pnpm run typecheck && pnpm run test:node",
    "test:node": "node --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "preflight": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "keywords": [
    "cdp",
    "chrome",
    "chromium",
    "screen-recording",
    "video-capture",
    "playwright",
    "puppeteer",
    "60fps",
    "120fps",
    "av1"
  ],
  "author": "Paul Irish",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "26.6.6",
    "devtools-protocol": "0.0.1734725",
    "oxlint": "1.92.0",
    "playwright-core": "1.65.0",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2"
  }
}
